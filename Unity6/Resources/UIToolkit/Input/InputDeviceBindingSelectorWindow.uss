/* Root Container */
#selector-root {
    padding: 10px;
    flex-direction: column;
    flex-grow: 1;
    overflow: hidden;
}

/* Title */
.selector-title {
    font-size: 14px;
    -unity-font-style-and-weight: bold;
    margin-bottom: 10px;
    flex-shrink: 0;
}

/* Search Field */
.selector-search-field {
    margin-bottom: 10px;
    flex-shrink: 0;
}

.search-placeholder {
    position: absolute;
    left: 5px;
    top: 3px;
    color: rgb(128, 128, 128);
}

/* Empty State */
.selector-empty-label {
    -unity-text-align: middle-center;
    color: rgb(153, 153, 153);
    margin-top: 50px;
}

/* Tab Container */
.selector-tab-container {
    flex-grow: 1;
    flex-direction: row;
}

/* Tab Buttons Column */
.selector-tab-buttons-column {
    width: 200px;
    border-right-width: 1px;
    border-right-color: rgb(77, 77, 77);
    margin-right: 5px;
}

/* Tab Content Container */
.selector-tab-content-container {
    flex-grow: 1;
}

/* Tab Button */
.selector-tab-button {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgb(64, 64, 64);
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
    border-right-width: 0;
    margin-bottom: 2px;
    -unity-font-style-and-weight: normal;
}

.selector-tab-button-active {
    background-color: rgb(89, 89, 89);
    -unity-font-style-and-weight: bold;
}

.selector-tab-button-content {
    flex-direction: row;
    flex-grow: 1;
}

.selector-tab-button-name {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.selector-tab-button-count {
    color: rgb(153, 153, 153);
    font-size: 10px;
    -unity-text-align: middle-right;
}

/* Tab Content */
.selector-tab-content {
    flex-grow: 1;
    display: none;
}

.selector-tab-content-active {
    display: flex;
}

/* Group Header */
.selector-group-header {
    font-size: 12px;
    -unity-font-style-and-weight: bold;
    padding-left: 10px;
    padding-top: 10px;
    padding-bottom: 5px;
    background-color: rgba(51, 51, 51, 0.5);
}

/* Group Separator */
.selector-group-separator {
    height: 2px;
    background-color: rgb(102, 102, 102);
    margin-bottom: 5px;
}

/* Group Spacer */
.selector-group-spacer {
    height: 10px;
}

/* List Item */
.selector-list-item {
    flex-direction: row;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(51, 51, 51);
}

.selector-list-item:hover {
    background-color: rgba(77, 77, 77, 0.5);
}

.selector-list-item-name {
    flex-grow: 1;
}

.selector-list-item-path {
    color: rgb(153, 153, 153);
    font-size: 10px;
}

/* Button Row */
.selector-button-row {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
}

.selector-close-button {
    width: 80px;
    height: 25px;
}

/* ===================== Listen for Input ===================== */

.listen-bar {
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    padding: 4px 8px;
    background-color: rgba(0, 0, 0, 0.15);
    flex-shrink: 0;
}

.listen-bar-top-row {
    flex-direction: row;
    align-items: center;
    height: 28px;
}

.listen-bar-icon {
    font-size: 16px;
    width: 24px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.listen-status-label {
    flex-grow: 1;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.6);
    margin-left: 4px;
    -unity-text-align: middle-left;
}

.listen-toggle-button {
    width: 110px;
    height: 22px;
    flex-shrink: 0;
    font-size: 11px;
}

.listen-toggle-button-active {
    background-color: rgba(220, 80, 80, 0.5);
    border-color: rgba(220, 80, 80, 0.8);
    color: white;
}

.listen-detected-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    background-color: rgba(60, 160, 80, 0.2);
    border-radius: 3px;
    padding: 3px 6px;
    height: 26px;
}

.listen-detected-check {
    color: rgb(100, 220, 120);
    font-size: 14px;
    width: 18px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.listen-detected-name {
    font-size: 11px;
    -unity-font-style: bold;
    color: white;
    min-width: 90px;
    flex-shrink: 0;
    margin-right: 6px;
}

.listen-detected-path {
    flex-grow: 1;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
    -unity-text-align: middle-left;
}

.listen-use-button {
    width: 48px;
    height: 20px;
    font-size: 11px;
    flex-shrink: 0;
    margin-left: 4px;
    background-color: rgba(60, 130, 200, 0.6);
    border-color: rgba(60, 130, 200, 0.9);
    color: white;
}

.listen-dismiss-button {
    width: 24px;
    height: 20px;
    font-size: 12px;
    flex-shrink: 0;
    margin-left: 2px;
    color: rgba(255, 255, 255, 0.5);
}
