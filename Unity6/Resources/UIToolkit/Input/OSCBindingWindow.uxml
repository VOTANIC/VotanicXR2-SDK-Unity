<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/Scripts/Input/Editor/OSCBindingWindow.uss?fileID=7433441132597879392&amp;guid=7bb06bbb406a8da4d81db5fc62134e71&amp;type=3#OSCBindingWindow" />
    <ui:VisualElement name="root" class="root-container">
        <ui:Label name="title-label" class="title-label" />
        <ui:Label text="Configure the OSC binding parameters:" class="description-label" />
        <ui:VisualElement class="input-row">
            <ui:Label text="Port:" class="input-label" />
            <uie:IntegerField name="port-field" class="input-field" />
        </ui:VisualElement>
        <ui:VisualElement class="input-row">
            <ui:Label text="OSC Address:" class="input-label" />
            <ui:TextField name="address-field" class="input-field" />
        </ui:VisualElement>
        <ui:VisualElement name="preview-container" class="preview-container">
            <ui:Label text="Binding Path Preview:" class="preview-title" />
            <ui:Label name="preview-path" class="preview-path" />
        </ui:VisualElement>
        <ui:VisualElement class="button-container">
            <ui:Button name="cancel-button" text="Cancel" class="dialog-button" />
            <ui:Button name="create-button" text="Create" class="dialog-button primary-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
