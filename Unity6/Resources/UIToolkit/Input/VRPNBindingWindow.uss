.root-container {
    padding: 15px;
}

.title-label {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 15px;
}

.description-label {
    font-size: 11px;
    color: rgb(179, 179, 179);
    margin-bottom: 15px;
}

.input-row {
    flex-direction: row;
    margin-bottom: 10px;
}

.input-label {
    width: 120px;
    -unity-text-align: middle-left;
}

.input-field {
    flex-grow: 1;
}

.preview-container {
    margin-top: 10px;
    margin-bottom: 20px;
    background-color: rgba(51, 51, 51, 0.5);
    padding: 8px 10px;
    border-radius: 3px;
}

.preview-title {
    font-size: 10px;
    color: rgb(153, 153, 153);
    margin-bottom: 5px;
}

.preview-path {
    font-size: 11px;
    color: rgb(204, 230, 255);
    -unity-font-style: bold;
}

.button-container {
    flex-direction: row;
    justify-content: flex-end;
}

.dialog-button {
    width: 80px;
    margin-left: 5px;
}

.primary-button {
}
