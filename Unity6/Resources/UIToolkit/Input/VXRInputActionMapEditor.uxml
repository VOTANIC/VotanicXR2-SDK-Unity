<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="main-container">
        <ui:VisualElement name="toolbar-container" />
        <ui:TwoPaneSplitView name="content-container" fixed-pane-initial-dimension="300" orientation="Horizontal">
            <ui:VisualElement name="left-panel" style="flex-grow: 1;" />
            <ui:VisualElement name="right-panel" style="flex-grow: 1;" />
        </ui:TwoPaneSplitView>
    </ui:VisualElement>
</ui:UXML>
