.vxr2-settings-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
}

.vxr2-settings-scroll > .unity-scroll-view__content-viewport {
    flex-grow: 1;
}

.vxr2-settings-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container,
.vxr2-settings-scroll .unity-scroll-view__content-container {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    min-width: 100%;
    align-items: stretch;
}

.vxr2-settings-root {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    max-width: none;
    min-width: 0;
    padding: 8px 12px 24px 8px;
}

.vxr2-settings-title {
    -unity-font-style: bold;
    font-size: 32px;
    margin-bottom: 12px;
    flex-shrink: 0;
    overflow: visible;
    white-space: normal;
}

.vxr2-settings-section {
    flex-shrink: 0;
    flex-grow: 0;
    width: 100%;
    max-width: none;
    margin: 0 0 20px 0;
    padding: 0;
}

.vxr2-settings-section-title {
    -unity-font-style: bold;
    margin-bottom: 6px;
    font-size: 20px;
    flex-shrink: 0;
    overflow: visible;
    white-space: normal;
}

.vxr2-settings-check {
    margin-bottom: 2px;
    flex-shrink: 0;
    width: 100%;
    max-width: none;
}

.vxr2-settings-check .unity-base-field__label,
.vxr2-settings-check .unity-toggle__label {
    min-width: auto;
    overflow: visible;
    text-overflow: clip;
    white-space: normal;
}

.vxr2-settings-button {
    align-self: flex-start;
    margin-top: 6px;
    margin-bottom: 4px;
    max-width: none;
    overflow: visible;
}

.vxr2-settings-button .unity-button__label {
    overflow: visible;
    text-overflow: clip;
    white-space: nowrap;
}

.vxr2-settings-status {
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
    color: rgb(180, 180, 180);
    margin-bottom: 6px;
    flex-shrink: 0;
    width: 100%;
}

#build-profiles-list {
    margin-top: 4px;
    flex-shrink: 0;
    width: 100%;
}

.vxr2-settings-help {
    margin-bottom: 10px;
    white-space: normal;
    flex-shrink: 0;
    width: 100%;
}

.vxr2-settings-help .unity-help-box__label {
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
}

.vxr2-profile-card {
    flex-shrink: 0;
    width: 100%;
    max-width: none;
    margin: 0 0 10px 0;
    padding: 8px 10px 10px 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.12);
}

.vxr2-profile-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    width: 100%;
}

.vxr2-profile-title {
    -unity-font-style: bold;
    font-size: 14px;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: visible;
    white-space: normal;
}

.vxr2-profile-header-buttons {
    flex-direction: row;
    flex-shrink: 0;
}

.vxr2-profile-header-buttons > .unity-button {
    margin-left: 4px;
}

.vxr2-path-block {
    margin-top: 4px;
    flex-shrink: 0;
    width: 100%;
}

.vxr2-path-row {
    flex-direction: row;
    align-items: flex-end;
    width: 100%;
}

.vxr2-path-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 80px;
}

.vxr2-browse-button {
    flex-shrink: 0;
    margin-left: 6px;
    margin-bottom: 1px;
    width: 72px;
}

.vxr2-scheme-block {
    margin-top: 8px;
    flex-shrink: 0;
    width: 100%;
}

.vxr2-scheme-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    width: 100%;
}

.vxr2-scheme-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 80px;
}

.vxr2-scheme-row > .unity-button {
    margin-left: 6px;
    flex-shrink: 0;
}

.vxr2-profile-actions {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 4px;
    width: 100%;
}

.vxr2-profile-actions > .unity-button {
    margin-right: 8px;
}
